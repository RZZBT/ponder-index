{"ponderIndex":1,"ecosystem":"crates","name":"num-integer","documents":[{"versions":">=0.1.44","ponder":{"version":1,"library":{"name":"num-integer"},"animations":{"gcd":{"symbol":"rust:num_integer::gcd","aliases":["sym:src/lib.rs:gcd"],"title":"How num_integer::gcd() works","description":"The greatest common divisor, by Euclid's algorithm.","actors":{"title":{"type":"text","x":500,"y":60,"text":"num_integer::gcd(48, 18)","fontSize":32,"fill":"text","anchor":"middle"},"note":{"type":"text","x":500,"y":118,"text":"the largest number that divides both","fontSize":24,"fill":"muted","anchor":"middle"},"l0":{"type":"text","x":500,"y":190,"text":"48 = 2 × 18 + 12","fontSize":28,"fill":"text","anchor":"middle","visible":false},"l1":{"type":"text","x":500,"y":244,"text":"18 = 1 × 12 + 6","fontSize":28,"fill":"text","anchor":"middle","visible":false},"l2":{"type":"text","x":500,"y":298,"text":"12 = 2 × 6 + 0","fontSize":28,"fill":"text","anchor":"middle","visible":false},"l3":{"type":"text","x":500,"y":352,"text":"remainder 0 → the answer is 6","fontSize":28,"fill":"text","anchor":"middle","visible":false}},"slides":[{"caption":"Euclid's idea: gcd(a, b) is the same as gcd(b, a mod b). Repeat until the remainder is 0."},{"caption":"48 divided by 18 leaves 12. Now find gcd(18, 12).","duration":900,"changes":{"l0":{"visible":true,"fill":"warning"}}},{"caption":"18 divided by 12 leaves 6. Now gcd(12, 6).","duration":900,"changes":{"l0":{"fill":"text"},"l1":{"visible":true,"fill":"warning"}}},{"caption":"12 divided by 6 leaves 0.","duration":900,"changes":{"l1":{"fill":"text"},"l2":{"visible":true,"fill":"warning"}}},{"caption":"When the remainder is 0, the last divisor is the answer: 6 divides both 48 and 18. (num-integer uses Stein's binary variant, which gives the same result.)","duration":900,"changes":{"l2":{"fill":"text"},"l3":{"visible":true,"fill":"warning"}}},{"caption":"gcd(48, 18) is 6, so 48/18 simplifies to 8/3. The result is never negative.","duration":500,"changes":{"note":{"text":"result: 6","fill":"success","fontSize":24},"l3":{"fill":"success"}}}]},"lcm":{"symbol":"rust:num_integer::lcm","aliases":["sym:src/lib.rs:lcm"],"title":"How num_integer::lcm() works","description":"The least common multiple: the smallest number both divide.","actors":{"title":{"type":"text","x":500,"y":60,"text":"num_integer::lcm(4, 6)","fontSize":32,"fill":"text","anchor":"middle"},"note":{"type":"text","x":500,"y":118,"text":"the smallest number that is a multiple of both","fontSize":24,"fill":"muted","anchor":"middle"},"l0":{"type":"text","x":500,"y":190,"text":"multiples of 4: 4, 8, 12, 16, …","fontSize":28,"fill":"text","anchor":"middle","visible":false},"l1":{"type":"text","x":500,"y":244,"text":"multiples of 6: 6, 12, 18, …","fontSize":28,"fill":"text","anchor":"middle","visible":false},"l2":{"type":"text","x":500,"y":298,"text":"gcd(4, 6) = 2","fontSize":28,"fill":"text","anchor":"middle","visible":false},"l3":{"type":"text","x":500,"y":352,"text":"4 × 6 / 2 = 12","fontSize":28,"fill":"text","anchor":"middle","visible":false}},"slides":[{"caption":"lcm() finds the first number that appears in both lists of multiples, without writing the lists."},{"caption":"Listing multiples shows 12 as the first shared one.","duration":900,"changes":{"l0":{"visible":true,"fill":"warning"},"l1":{"visible":true,"fill":"warning"}}},{"caption":"lcm() uses the gcd instead: 2 is the largest number that divides both.","duration":900,"changes":{"l0":{"fill":"text"},"l1":{"fill":"text"},"l2":{"visible":true,"fill":"warning"}}},{"caption":"a × b counts the shared factor twice; dividing by the gcd removes it once.","duration":900,"changes":{"l2":{"fill":"text"},"l3":{"visible":true,"fill":"warning"}}},{"caption":"lcm(4, 6) is 12: the first time two cycles of 4 and 6 steps line up again. (It divides before multiplying, to avoid overflow.)","duration":500,"changes":{"note":{"text":"result: 12","fill":"success","fontSize":24},"l3":{"fill":"success"}}}]},"div-floor":{"symbol":"rust:num_integer::Integer::div_floor","aliases":["sym:src/lib.rs:Integer.div_floor"],"title":"How Integer::div_floor() works","description":"Integer division that rounds down, also for negative numbers.","actors":{"title":{"type":"text","x":500,"y":60,"text":"(-7).div_floor(&2)","fontSize":32,"fill":"text","anchor":"middle"},"note":{"type":"text","x":500,"y":118,"text":"-7 / 2 = -3.5: which way to round?","fontSize":24,"fill":"muted","anchor":"middle"},"n0":{"type":"group","x":200,"y":260},"n0r":{"type":"rectangle","parent":"n0","x":0,"y":0,"width":70,"height":56,"cornerRadius":10,"fill":"surface","stroke":"text","strokeWidth":2},"n0t":{"type":"text","parent":"n0","x":0,"y":0,"text":"-5","fontSize":26,"fill":"text","anchor":"middle"},"n1":{"type":"group","x":320,"y":260},"n1r":{"type":"rectangle","parent":"n1","x":0,"y":0,"width":70,"height":56,"cornerRadius":10,"fill":"surface","stroke":"text","strokeWidth":2},"n1t":{"type":"text","parent":"n1","x":0,"y":0,"text":"-4","fontSize":26,"fill":"text","anchor":"middle"},"n2":{"type":"group","x":440,"y":260},"n2r":{"type":"rectangle","parent":"n2","x":0,"y":0,"width":70,"height":56,"cornerRadius":10,"fill":"surface","stroke":"text","strokeWidth":2},"n2t":{"type":"text","parent":"n2","x":0,"y":0,"text":"-3","fontSize":26,"fill":"text","anchor":"middle"},"n3":{"type":"group","x":560,"y":260},"n3r":{"type":"rectangle","parent":"n3","x":0,"y":0,"width":70,"height":56,"cornerRadius":10,"fill":"surface","stroke":"text","strokeWidth":2},"n3t":{"type":"text","parent":"n3","x":0,"y":0,"text":"-2","fontSize":26,"fill":"text","anchor":"middle"},"n4":{"type":"group","x":680,"y":260},"n4r":{"type":"rectangle","parent":"n4","x":0,"y":0,"width":70,"height":56,"cornerRadius":10,"fill":"surface","stroke":"text","strokeWidth":2},"n4t":{"type":"text","parent":"n4","x":0,"y":0,"text":"-1","fontSize":26,"fill":"text","anchor":"middle"},"n5":{"type":"group","x":800,"y":260},"n5r":{"type":"rectangle","parent":"n5","x":0,"y":0,"width":70,"height":56,"cornerRadius":10,"fill":"surface","stroke":"text","strokeWidth":2},"n5t":{"type":"text","parent":"n5","x":0,"y":0,"text":"0","fontSize":26,"fill":"text","anchor":"middle"},"p":{"type":"text","x":380,"y":200,"text":"-3.5","fontSize":26,"fill":"warning","anchor":"middle"},"eq":{"type":"text","x":500,"y":380,"text":"","fontSize":26,"fill":"warning","anchor":"middle"}},"slides":[{"caption":"The exact answer, -3.5, lies between -4 and -3."},{"caption":"Rust's / operator rounds towards zero: -7 / 2 is -3.","duration":900,"changes":{"n2r":{"fill":"danger"},"eq":{"text":"-7 / 2 = -3 (towards zero)","fontSize":26}}},{"caption":"div_floor() rounds down, towards minus infinity: -4.","duration":900,"changes":{"n1r":{"fill":"success"},"eq":{"text":"(-7).div_floor(&2) = -4 (down)","fontSize":26}}},{"caption":"For positive numbers both agree: 7 / 2 and 7.div_floor(&2) are both 3. Rounding down is what you want for things like \"which bucket of size 2 holds -7\".","duration":900,"changes":{"eq":{"text":"7 / 2 = 7.div_floor(&2) = 3","fontSize":26}}},{"caption":"div_floor() pairs with mod_floor(): -4 × 2 + 1 = -7. Since Rust 1.38, i32::div_euclid() is similar (it differs when the divisor is negative).","duration":500,"changes":{"note":{"text":"result: -4 (while -7 / 2 = -3)","fill":"success","fontSize":24},"eq":{"text":"","fontSize":26}}}]},"mod-floor":{"symbol":"rust:num_integer::Integer::mod_floor","aliases":["sym:src/lib.rs:Integer.mod_floor"],"title":"How Integer::mod_floor() works","description":"The remainder that has the sign of the divisor.","actors":{"title":{"type":"text","x":500,"y":60,"text":"(-7).mod_floor(&2)","fontSize":32,"fill":"text","anchor":"middle"},"note":{"type":"text","x":500,"y":118,"text":"-7 % 2 is -1 in Rust; mod_floor gives 1","fontSize":24,"fill":"muted","anchor":"middle"},"l0":{"type":"text","x":500,"y":190,"text":"% pairs with / (towards zero): -7 = -3 × 2 + (-1)","fontSize":28,"fill":"text","anchor":"middle","visible":false},"l1":{"type":
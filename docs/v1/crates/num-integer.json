 15)","fontSize":28,"fill":"text","anchor":"middle","visible":false},"l1":{"type":"text","x":500,"y":244,"text":"what is left? 17 − 15 = 2","fontSize":28,"fill":"text","anchor":"middle","visible":false},"l2":{"type":"text","x":500,"y":298,"text":"(3, 2)","fontSize":28,"fill":"text","anchor":"middle","visible":false},"l3":{"type":"text","x":500,"y":352,"text":"check: 3 × 5 + 2 = 17","fontSize":28,"fill":"text","anchor":"middle","visible":false}},"slides":[{"caption":"div_rem() does / and % together and returns both as a tuple."},{"caption":"The quotient: 5 fits into 17 three times.","duration":900,"changes":{"l0":{"visible":true,"fill":"warning"}}},{"caption":"The remainder: 2 is left over.","duration":900,"changes":{"l0":{"fill":"text"},"l1":{"visible":true,"fill":"warning"}}},{"caption":"Both come back together, so you can write let (q, r) = 17.div_rem(&5);","duration":900,"changes":{"l1":{"fill":"text"},"l2":{"visible":true,"fill":"warning"}}},{"caption":"They always satisfy q × divisor + r = number.","duration":900,"changes":{"l2":{"fill":"text"},"l3":{"visible":true,"fill":"warning"}}},{"caption":"17.div_rem(&5) is (3, 2). It rounds towards zero like / and %; div_mod_floor() is the rounding-down version.","duration":500,"changes":{"note":{"text":"result: (3, 2)","fill":"success","fontSize":24},"l3":{"fill":"success"}}}]},"binomial":{"symbol":"rust:num_integer::binomial","aliases":["sym:src/lib.rs:binomial"],"title":"How num_integer::binomial() works","description":"The number of ways to choose k items out of n.","actors":{"title":{"type":"text","x":500,"y":60,"text":"num_integer::binomial(5, 2)","fontSize":32,"fill":"text","anchor":"middle"},"note":{"type":"text","x":500,"y":118,"text":"ways to choose 2 of 5 = row 5 of Pascal's triangle","fontSize":24,"fill":"muted","anchor":"middle"},"p0_0":{"type":"group","x":500,"y":175},"p0_0r":{"type":"rectangle","parent":"p0_0","x":0,"y":0,"width":64,"height":50,"cornerRadius":10,"fill":"surface","stroke":"text","strokeWid